# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Logs
*.log
logs/

# Environment / Secrets
.env
.env.*
!.env.example
!docker/.env.example
docker/odoo_fixed.conf

# Credentials issued by scripts/clients/*.py and scripts/rotate_passwords.py.
# They are handed over and then deleted; nothing here ever belongs in git,
# because removing a password from a file does not remove it from the history.
secrets/
*-users.txt

# IDE
.vscode/
.idea/
*.swp
*.swo

# Odoo runtime data
filestore/
sessions/
.local/share/Odoo/

# Docker runtime data
postgres_data/

# Temporary files
/tmp/
*.tmp
*.bak
*.orig

# Replit
.replit
replit.nix
.upm/

# OCA clones are ~1.4GB of git metadata and are reproducible from
# third_party/oca-repos.txt via scripts/fetch-oca.sh
third_party/OCA/

# Backups are data, not source
backups/
