# Mizan ERP — environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# PostgreSQL credentials used by both the db and odoo services.
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_me_strong_password

# Optional overrides (defaults shown above are used if not set).
# ODOO_ADMIN_PASSWD=change_me_admin_password
