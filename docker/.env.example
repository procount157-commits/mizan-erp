# Mizan ERP — Docker environment variables
# Copy this file to docker/.env and fill in your values.
# docker/.env is git-ignored and must NEVER be committed.
#
# Usage:
#   cp docker/.env.example docker/.env
#   # edit docker/.env with real values
#   cd docker && docker compose up -d

# PostgreSQL role and database name.
# Both the db and odoo services read these variables.
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_me_strong_password
