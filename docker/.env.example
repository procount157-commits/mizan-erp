# Mizan ERP — Docker environment variables
# Copy this file to docker/.env and fill in your values.
# docker/.env is git-ignored and must NEVER be committed.
#
# Usage:
#   cp docker/.env.example docker/.env
#   # edit docker/.env with real values
#   cd docker && docker compose up -d

# PostgreSQL role and database name.
# Both the db and odoo services read these variables.
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_me_strong_password

# Which database the client-facing port (8069) serves. It must resolve to
# exactly one database, otherwise visitors are asked to pick one and the
# database manager is disabled, so they see an error instead of a login.
#   with real subdomains:  ^%d$      (alamana.proaccount.ae -> alamana)
#   on a LAN IP:           ^alamana$ (pin the single client)
CLIENT_DB_FILTER=^%d$

# The operations console database, served on port 8070.
OPS_DB=mizan_ops
