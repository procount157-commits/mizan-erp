<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_case_company" model="ir.rule">
            <field name="name">Workflow files: own company</field>
            <field name="model_id" ref="model_mizan_workflow_case"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_template_company" model="ir.rule">
            <field name="name">Workflow templates: own company</field>
            <field name="model_id" ref="model_mizan_workflow_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
