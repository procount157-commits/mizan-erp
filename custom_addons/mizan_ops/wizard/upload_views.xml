<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_upload_form" model="ir.ui.view">
        <field name="name">mizan.ops.upload.form</field>
        <field name="model">mizan.ops.upload</field>
        <field name="arch" type="xml">
            <form string="Upload a File">
                <group>
                    <div class="alert alert-info mb-2" role="status" colspan="2" invisible="case_id or task_id">
                        Not linked to a step? Upload anyway: the file goes to the Operations documents.
                    </div>
                    <field name="case_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="task_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="file" filename="filename" widget="binary"/>
                    <field name="filename" invisible="1"/>
                    <field name="note" placeholder="Trade licence 2026, signed contract, receipt…"/>
                    <field name="mark_done" invisible="not task_id"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Upload" class="btn-primary btn-lg"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ops_upload" model="ir.actions.act_window">
        <field name="name">Upload a File</field>
        <field name="res_model">mizan.ops.upload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
