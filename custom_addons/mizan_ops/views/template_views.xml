<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_template_list" model="ir.ui.view">
        <field name="name">mizan.workflow.template.list</field>
        <field name="model">mizan.workflow.template</field>
        <field name="arch" type="xml">
            <list string="Workflow Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="step_count" string="Steps"/>
                <field name="days_total"/>
                <field name="case_count" string="Started"/>
                <field name="responsible_id" widget="many2one_avatar_user" optional="show"/>
                <button name="action_start" type="object" string="Start" icon="fa-play" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_template_form" model="ir.ui.view">
        <field name="name">mizan.workflow.template.form</field>
        <field name="model">mizan.workflow.template</field>
        <field name="arch" type="xml">
            <form string="Workflow Template">
                <header>
                    <button name="action_start" type="object" string="Start this workflow" class="btn-primary" icon="fa-play"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_cases" type="object" class="oe_stat_button" icon="fa-folder-open-o">
                            <field name="case_count" widget="statinfo" string="Started"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Trade licence renewal"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="days_total"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="When this workflow is used, and what the result should be."/>
                    <notebook>
                        <page string="Steps" name="steps">
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="days"/>
                                    <field name="assignee_id" widget="many2one_avatar_user"/>
                                    <field name="requires_file" widget="boolean_toggle"/>
                                    <field name="needs_client" widget="boolean_toggle"/>
                                    <field name="instructions" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ops_template" model="ir.actions.act_window">
        <field name="name">Workflow Templates</field>
        <field name="res_model">mizan.workflow.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Write down how a recurring job is done</p>
            <p>A licence renewal, a VAT return, a handover: its steps, who does each one, how many days it gets, and whether it needs a file. Starting it later is one tap.</p>
        </field>
    </record>
</odoo>
