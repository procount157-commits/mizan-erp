<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Our own activity type, so the reminder can be found and closed
             again by what it is rather than by matching a translated title. -->
        <record id="activity_daily_report" model="mail.activity.type">
            <field name="name">Daily site report</field>
            <field name="summary">File today's site report</field>
            <field name="icon">fa-file-text-o</field>
            <field name="res_model">project.project</field>
            <field name="delay_count">0</field>
        </record>

        <!-- 12:00 UTC is 16:00 in the UAE: late enough that the day's work is
             known, early enough that the engineer is still on site to write
             it. Which weekdays it runs is a parameter, because a contractor's
             week is not the government's. -->
        <record id="cron_daily_report_reminder" model="ir.cron">
            <field name="name">Site: remind engineers to file the daily report</field>
            <field name="model_id" ref="model_mizan_site_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily_report_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/>
            <field name="active" eval="True"/>
        </record>

        <record id="param_report_weekdays" model="ir.config_parameter">
            <field name="key">mizan_site.report_weekdays</field>
            <!-- Monday is 0. Monday to Saturday: most UAE sites work Saturday
                 and stop on Sunday. -->
            <field name="value">0,1,2,3,4,5</field>
        </record>
    </data>
</odoo>
