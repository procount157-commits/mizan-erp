<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- An engineer sees the incidents he raised; the office sees them all. -->
    <record id="rule_incident_own" model="ir.rule">
        <field name="name">Safety incidents: your own</field>
        <field name="model_id" ref="model_mizan_site_incident"/>
        <field name="domain_force">[('reporter_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('mizan_site.group_site_engineer'))]"/>
    </record>
    <record id="rule_incident_all" model="ir.rule">
        <field name="name">Safety incidents: the office reads all</field>
        <field name="model_id" ref="model_mizan_site_incident"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('mizan_site.group_site_manager')),
                                    (4, ref('project.group_project_manager')),
                                    (4, ref('mizan_hub.group_general_manager')),
                                    (4, ref('account.group_account_manager')),
                                    (4, ref('account.group_account_readonly'))]"/>
    </record>
</odoo>
