<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- An engineer raises things. He does not approve them and he does
             not post them, and that is not a limitation of the role — it is
             the reason the role can exist on a phone at all. -->
        <record id="group_site_engineer" model="res.groups">
            <field name="name">Site Engineer</field>
            <field name="category_id" ref="mizan_hub.module_category_proaccount"/>
            <field name="implied_ids"
                   eval="[(4, ref('project.group_project_user')),
                          (4, ref('hr_timesheet.group_hr_timesheet_user'))]"/>
            <field name="comment">Files daily reports, raises material and
                purchase requests, claims expenses and logs time — on his own
                projects only. Approves nothing and posts nothing.</field>
        </record>

        <record id="group_site_manager" model="res.groups">
            <field name="name">Site Manager</field>
            <field name="category_id" ref="mizan_hub.module_category_proaccount"/>
            <field name="implied_ids"
                   eval="[(4, ref('mizan_site.group_site_engineer'))]"/>
            <field name="comment">Reads every project's reports and
                acknowledges them.</field>
        </record>

        <!-- An engineer sees the days he filed. Anything wider is a different
             job, and giving it away by default is how a site login becomes a
             way to read the whole company. -->
        <record id="rule_report_own" model="ir.rule">
            <field name="name">Site reports: your own</field>
            <field name="model_id" ref="model_mizan_site_report"/>
            <field name="domain_force">[('author_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('mizan_site.group_site_engineer'))]"/>
        </record>

        <record id="rule_report_all" model="ir.rule">
            <field name="name">Site reports: the office reads all</field>
            <field name="model_id" ref="model_mizan_site_report"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mizan_site.group_site_manager')),
                                        (4, ref('project.group_project_manager')),
                                        (4, ref('account.group_account_manager')),
                                        (4, ref('account.group_account_readonly'))]"/>
        </record>
    </data>
</odoo>
