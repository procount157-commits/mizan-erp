<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_close_form" model="ir.ui.view">
        <field name="name">mizan.month.close.form</field>
        <field name="model">mizan.month.close</field>
        <field name="arch" type="xml">
            <form string="Month-End Close">
                <header>
                    <button name="action_run_checks" type="object"
                            string="Run the checks" class="btn-primary"
                            invisible="state == 'closed'"/>
                    <button name="action_close" type="object"
                            string="Close the period" class="btn-primary"
                            invisible="state != 'checking' or not ready"
                            confirm="This writes the global lock date. Entries up to and including the end of the period will be pushed to a later date. It can be undone by reopening."/>
                    <button name="action_close" type="object"
                            string="Close the period"
                            invisible="state != 'checking' or ready"
                            help="Blocked while a blocking check is failing."/>
                    <button name="action_reopen" type="object"
                            string="Reopen" invisible="state != 'closed'"
                            confirm="This puts the lock date back where it was before this close."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from" readonly="state == 'closed'"/>
                            <field name="date_to" readonly="state == 'closed'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="checked_on" readonly="1"/>
                            <field name="blocking_count" readonly="1"/>
                            <field name="warning_count" readonly="1"/>
                            <field name="ready" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="state != 'closed'">
                        <group>
                            <field name="closed_by_id" readonly="1"/>
                            <field name="closed_on" readonly="1"/>
                        </group>
                        <group>
                            <field name="closed_over_warnings" readonly="1"/>
                            <field name="lock_date_before" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checks">
                            <field name="check_ids" readonly="1">
                                <list create="false" delete="false"
                                      decoration-danger="not passed and blocking"
                                      decoration-warning="not passed and not blocking"
                                      decoration-success="passed">
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="blocking"/>
                                    <field name="count"/>
                                    <field name="passed"/>
                                    <field name="note"/>
                                    <button name="action_review" type="object"
                                            icon="fa-list" string="Review"
                                            invisible="passed"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note">
                            <field name="note" placeholder="What was unusual about this month, for whoever reads it later."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_close_list" model="ir.ui.view">
        <field name="name">mizan.month.close.list</field>
        <field name="model">mizan.month.close</field>
        <field name="arch" type="xml">
            <list string="Month-End Close"
                  decoration-success="state == 'closed'"
                  decoration-danger="blocking_count > 0">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="blocking_count"/>
                <field name="warning_count"/>
                <field name="closed_by_id"/>
                <field name="closed_on"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="action_month_close" model="ir.actions.act_window">
        <field name="name">Month-End Close</field>
        <field name="res_model">mizan.month.close</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Close a month with evidence rather than memory.</p>
            <p>Create the period, run the checks, open whatever they find, and close.</p>
        </field>
    </record>

</odoo>
