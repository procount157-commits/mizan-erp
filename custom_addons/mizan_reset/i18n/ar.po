#. module: mizan_reset
#: model:ir.actions.act_window,name:mizan_reset.action_reset
#: model:ir.ui.menu,name:mizan_reset.menu_reset
#: model_terms:ir.ui.view,arch_db:mizan_reset.view_reset_form
msgid "Clean test data"
msgstr "مسح البيانات التجريبية"

#. module: mizan_reset
#: model_terms:ir.ui.view,arch_db:mizan_reset.view_reset_form
msgid "Deletes every document and test record: entries, invoices, payments, bank lines,\n                    contracts, claims, subcontracts, plant, projects, tasks, expenses, orders, contacts,\n                    products and test employees. The chart of accounts, taxes, journals and the set-up stay.\n                    A full backup is taken first."
msgstr "يحذف كل المستندات والسجلات التجريبية: القيود، الفواتير، المدفوعات، حركات البنك، العقود، المستخلصات، مقاولي الباطن، الآليات، المشاريع، المهام، المصروفات، الأوامر، جهات الاتصال، المنتجات والموظفين التجريبيين. يبقى دليل الحسابات والضرائب والدفاتر والإعدادات. تؤخذ نسخة احتياطية كاملة أولاً."

#. module: mizan_reset
#: model_terms:ir.ui.view,arch_db:mizan_reset.view_reset_form
msgid "Type the company name"
msgstr "اكتب اسم الشركة"

#. module: mizan_reset
#: model_terms:ir.ui.view,arch_db:mizan_reset.view_reset_form
msgid "Done"
msgstr "تم"

#. module: mizan_reset
#: model_terms:ir.ui.view,arch_db:mizan_reset.view_reset_form
msgid "Delete the test data"
msgstr "احذف البيانات التجريبية"

#. module: mizan_reset
#: model_terms:ir.ui.view,arch_db:mizan_reset.view_reset_form
msgid "This cannot be undone except from the backup. Continue?"
msgstr "لا يمكن التراجع عن هذا إلا من النسخة الاحتياطية. متابعة؟"

#. module: mizan_reset
#: model_terms:ir.ui.view,arch_db:mizan_reset.view_reset_form
msgid "Close"
msgstr "إغلاق"

#. module: mizan_reset
#: model:ir.model.fields,field_description:mizan_reset.field_mizan_reset_data__company_name
msgid "Company Name"
msgstr "اسم الشركة"

#. module: mizan_reset
#: model:ir.model.fields,field_description:mizan_reset.field_mizan_reset_data__confirm
msgid "Type the company name to confirm"
msgstr "اكتب اسم الشركة للتأكيد"

#. module: mizan_reset
#: model:ir.model.fields,field_description:mizan_reset.field_mizan_reset_data__archive_role_users
msgid "Archive the test users (engineers, accountant, manager…)"
msgstr "أرشفة المستخدمين التجريبيين (المهندسون، المحاسب، المدير…)"

#. module: mizan_reset
#: model:ir.model.fields,field_description:mizan_reset.field_mizan_reset_data__create_tester
msgid "Create the full-access test account (test@alamana.ae)"
msgstr "إنشاء حساب الاختبار بكل الصلاحيات (test@alamana.ae)"

