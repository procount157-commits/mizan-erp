#. module: mizan_mail
#: model:mail.template,body_html:mizan_mail.mail_template_invoice
msgid ""
"<div style=\"font-family: Tahoma, Arial, sans-serif; font-size: 14px; color: #1c2430; line-height: 1.7;\">\n"
"    <div dir=\"rtl\" style=\"text-align: right;\">\n"
"        <p>السادة <t t-out=\"object.partner_id.name or ''\"/>،</p>\n"
"        <p>تحية طيبة، مرفق لكم الفاتورة <strong t-out=\"object.name or ''\"/>\n"
"            بتاريخ <t t-out=\"format_date(object.invoice_date) or ''\"/>.</p>\n"
"        <table style=\"border-collapse: collapse; margin: 12px 0;\">\n"
"            <tr><td style=\"padding: 6px 12px; color: #6b7686;\">المبلغ الإجمالي</td>\n"
"                <td style=\"padding: 6px 12px; font-weight: bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\"/></tr>\n"
"            <tr t-if=\"object.amount_residual != object.amount_total\"><td style=\"padding: 6px 12px; color: #6b7686;\">المتبقي</td>\n"
"                <td style=\"padding: 6px 12px; font-weight: bold;\" t-out=\"format_amount(object.amount_residual, object.currency_id) or ''\"/></tr>\n"
"            <tr t-if=\"object.invoice_date_due\"><td style=\"padding: 6px 12px; color: #6b7686;\">تاريخ الاستحقاق</td>\n"
"                <td style=\"padding: 6px 12px; font-weight: bold;\" t-out=\"format_date(object.invoice_date_due) or ''\"/></tr>\n"
"            <tr t-if=\"object.payment_reference\"><td style=\"padding: 6px 12px; color: #6b7686;\">مرجع الدفع</td>\n"
"                <td style=\"padding: 6px 12px;\" t-out=\"object.payment_reference or ''\"/></tr>\n"
"        </table>\n"
"        <p t-if=\"object.get_portal_url()\">\n"
"            <a t-att-href=\"object.get_base_url() + object.get_portal_url()\" style=\"display: inline-block; background: #1BAE5A; color: #ffffff; padding: 10px 22px; border-radius: 8px; text-decoration: none; font-weight: bold;\">عرض الفاتورة</a>\n"
"        </p>\n"
"        <p>لأي استفسار يسعدنا تواصلكم بالرد على هذه الرسالة.<br/>مع خالص التحية،<br/><t t-out=\"object.company_id.name or ''\"/></p>\n"
"    </div>\n"
"    <hr style=\"border: 0; border-top: 1px solid #e4e9ef; margin: 18px 0;\"/>\n"
"    <div dir=\"ltr\" style=\"text-align: left; color: #4b5563;\">\n"
"        <p>Dear <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"        <p>Please find attached invoice <strong t-out=\"object.name or ''\"/>\n"
"            of <strong t-out=\"format_amount(object.amount_total, object.currency_id) or ''\"/><t t-if=\"object.invoice_date_due\">,\n"
"            due on <t t-out=\"format_date(object.invoice_date_due) or ''\"/></t>.</p>\n"
"        <p>Kind regards,<br/><t t-out=\"object.company_id.name or ''\"/></p>\n"
"    </div>\n"
"</div>\n"
"            "
msgstr ""

#. module: mizan_mail
#: model:mail.template,body_html:mizan_mail.mail_template_reminder
msgid ""
"<div style=\"font-family: Tahoma, Arial, sans-serif; font-size: 14px; color: #1c2430; line-height: 1.7;\">\n"
"    <div dir=\"rtl\" style=\"text-align: right;\">\n"
"        <p>السادة <t t-out=\"object.partner_id.name or ''\"/>،</p>\n"
"        <p>نود تذكيركم بأن الفاتورة <strong t-out=\"object.name or ''\"/>\n"
"            استحقت بتاريخ <strong t-out=\"format_date(object.invoice_date_due) or ''\"/>،\n"
"            والمبلغ المتبقي عليها <strong t-out=\"format_amount(object.amount_residual, object.currency_id) or ''\"/>.</p>\n"
"        <p>إذا كنتم قد سددتم المبلغ فنرجو تجاهل هذه الرسالة وإرسال إشعار التحويل بالرد عليها.</p>\n"
"        <p t-if=\"object.get_portal_url()\">\n"
"            <a t-att-href=\"object.get_base_url() + object.get_portal_url()\" style=\"display: inline-block; background: #1BAE5A; color: #ffffff; padding: 10px 22px; border-radius: 8px; text-decoration: none; font-weight: bold;\">عرض الفاتورة</a>\n"
"        </p>\n"
"        <p>مع خالص التحية،<br/><t t-out=\"object.company_id.name or ''\"/></p>\n"
"    </div>\n"
"    <hr style=\"border: 0; border-top: 1px solid #e4e9ef; margin: 18px 0;\"/>\n"
"    <div dir=\"ltr\" style=\"text-align: left; color: #4b5563;\">\n"
"        <p>Dear <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"        <p>This is a reminder that invoice <strong t-out=\"object.name or ''\"/> was due on\n"
"            <t t-out=\"format_date(object.invoice_date_due) or ''\"/>, with\n"
"            <strong t-out=\"format_amount(object.amount_residual, object.currency_id) or ''\"/> still open.\n"
"            If you have already paid, please ignore this message and reply with the transfer advice.</p>\n"
"        <p>Kind regards,<br/><t t-out=\"object.company_id.name or ''\"/></p>\n"
"    </div>\n"
"</div>\n"
"            "
msgstr ""

