<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice form: a reminder button on overdue invoices, and how many
         have gone out already. -->
    <record id="view_move_form_mail" model="ir.ui.view">
        <field name="name">account.move.form.mizan.mail</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="after">
                <button name="action_mizan_send_reminder" type="object" string="Send reminder"
                        icon="fa-bell" invisible="not mizan_is_overdue"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="mizan_is_overdue" invisible="1"/>
                <field name="mizan_reminder_count" invisible="mizan_reminder_count == 0" readonly="1"/>
                <field name="mizan_last_reminder" invisible="not mizan_last_reminder" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Invoice list: was it sent, how many reminders, and a bulk reminder. -->
    <record id="view_out_invoice_tree_mail" model="ir.ui.view">
        <field name="name">account.out.invoice.list.mizan.mail</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="action_mizan_send_reminder" type="object" string="Send reminder"/>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="is_move_sent" string="Sent" widget="boolean" optional="show"/>
                <field name="mizan_reminder_count" string="Reminders" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_filter_mail" model="ir.ui.view">
        <field name="name">account.move.search.mizan.mail</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="due_date" position="before">
                <filter name="not_sent" string="Not sent yet"
                        domain="[('is_move_sent', '=', False), ('state', '=', 'posted'), ('move_type', 'in', ('out_invoice', 'out_refund'))]"/>
                <filter name="reminded" string="Reminded" domain="[('mizan_reminder_count', '>', 0)]"/>
                <separator/>
            </filter>
        </field>
    </record>

    <!-- Customers with no email: the reason a send fails. -->
    <record id="action_customers_no_email" model="ir.actions.act_window">
        <field name="name">Customers without email</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('customer_rank', '>', 0), '|', ('email', '=', False), ('email', '=', '')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every customer has an email address</p>
        </field>
    </record>

    <menuitem id="menu_mail_setup" name="Email setup" parent="account.menu_finance_configuration"
              action="action_mail_setup" sequence="1" groups="account.group_account_manager"/>
    <menuitem id="menu_customers_no_email" name="Customers without email" parent="account.menu_finance_receivables"
              action="action_customers_no_email" sequence="99"/>
</odoo>
