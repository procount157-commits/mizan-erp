<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_expiry" model="ir.ui.view">
        <field name="name">hr.employee.form.mizan.expiry</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_mizan_expiries" type="object" class="oe_stat_button" icon="fa-calendar-times-o"
                        groups="hr.group_hr_user">
                    <field name="mizan_expiry_count" widget="statinfo" string="Expiries"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='visa_expire']" position="after">
                <field name="mizan_eid_number"/>
                <field name="mizan_eid_expiry"/>
                <field name="mizan_passport_expiry"/>
                <field name="mizan_medical_expiry"/>
            </xpath>
        </field>
    </record>
</odoo>
