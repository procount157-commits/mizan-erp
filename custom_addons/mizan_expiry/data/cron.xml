<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_expiry_daily" model="ir.cron">
        <field name="name">Expiries: refresh and warn</field>
        <field name="model_id" ref="model_mizan_expiry_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_daily()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(hours=1)).strftime('%Y-%m-%d 04:00:00')"/>
    </record>
</odoo>
