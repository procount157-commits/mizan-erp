#: code:addons/mizan_bank_pdf/models/statement_import.py:0
msgid "%(n)s line(s) imported: %(done)s reconciled automatically, %(left)s waiting for review."
msgstr "استُورد %(n)s سطر: %(done)s طوبقت تلقائياً، و%(left)s تنتظر المراجعة."

#. module: mizan_bank_pdf
#: model_terms:ir.ui.view,arch_db:mizan_bank_pdf.view_statement_import_form_pdf
msgid "<b>PDF statements are read too.</b> Upload the statement as the bank gives it — PDF, Excel, CSV or CAMT.\n                    It is imported only if every row adds up to the bank's own balance, then reconciled automatically:\n                    what is certain is matched at once, the rest waits for your review with a proposal."
msgstr "<b>تُقرأ كشوف PDF أيضاً.</b> ارفع الكشف كما يعطيك إياه البنك — PDF أو Excel أو CSV أو CAMT. يُستورد فقط إذا تطابق كل سطر مع رصيد البنك نفسه، ثم يُطابق تلقائياً: المؤكد يُطابق فوراً، والباقي ينتظر مراجعتك مع اقتراح."

