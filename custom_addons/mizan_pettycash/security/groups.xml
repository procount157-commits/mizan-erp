<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- The engineers' manager approves his team's receipts. Odoo's own
             rule then limits it to the people who report to him. -->
        <record id="mizan_site.group_site_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('hr_expense.group_hr_expense_team_approver'))]"/>
        </record>

        <!-- ...and sees his team's cash, not only his own. -->
        <record id="rule_advance_team" model="ir.rule">
            <field name="name">Advances: my team</field>
            <field name="model_id" ref="mizan_advance.model_mizan_employee_advance"/>
            <field name="domain_force">['|', ('employee_id.parent_id.user_id', '=', user.id),
                                             ('employee_id.expense_manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_expense.group_hr_expense_team_approver'))]"/>
        </record>
    </data>
</odoo>
