<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ai" model="ir.ui.view">
        <field name="name">account.move.form.mizan.ai</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mizan_ai_read" type="object" string="Read the invoice (AI)" icon="fa-magic"
                        class="btn-secondary" invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund')"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Read by AI" name="mizan_ai" invisible="not mizan_ai_checked" groups="account.group_account_invoice">
                    <field name="mizan_ai_checked" invisible="1"/>
                    <field name="mizan_ai_data" widget="text" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
