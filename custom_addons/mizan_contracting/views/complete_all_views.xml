<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- On the claim, beside the step buttons it replaces. -->
    <record id="view_progress_claim_form_complete" model="ir.ui.view">
        <field name="name">mizan.progress.claim.form.complete</field>
        <field name="model">mizan.progress.claim</field>
        <field name="inherit_id" ref="mizan_contracting.view_progress_claim_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_complete_all" type="object"
                        string="Complete All" class="btn-primary"
                        invisible="state == 'cancel'"
                        help="Run every remaining step: submit, certify, raise
                              the tax invoice, post it, withhold the retention
                              and recover the advance."/>
            </xpath>
        </field>
    </record>

    <!-- On any invoice or bill. -->
    <record id="view_move_form_complete_all" model="ir.ui.view">
        <field name="name">account.move.form.complete.all</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mizan_complete_all" type="object"
                        string="Complete All" class="btn-primary"
                        invisible="state == 'cancel'"
                        help="Post the document, then withhold the retention and
                              recover the advance that the contract calls for."/>
            </xpath>
        </field>
    </record>

    <!-- And from any list, on the whole selection — which is where it is
         needed most: a month's claims at once, not one document at a time.

         A list <header> button rather than a server action bound to the model.
         ir.actions.server carries exactly one access rule in Odoo — read for
         the Settings group — so a bound action's entry in the Actions menu is
         invisible to every ordinary user, including the finance manager. The
         button was there and he genuinely could not reach it. A header button
         is part of the view, acts on the selection, and needs no such right. -->
    <record id="view_move_list_complete_all" model="ir.ui.view">
        <field name="name">account.move.list.complete.all</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_mizan_complete_all" type="object"
                            string="Complete All" class="btn-primary"
                            display="always"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_move_list_complete_all_entries" model="ir.ui.view">
        <field name="name">account.move.list.complete.all.entries</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_mizan_complete_all" type="object"
                            string="Complete All" class="btn-primary"
                            display="always"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_progress_claim_list_complete_all" model="ir.ui.view">
        <field name="name">mizan.progress.claim.list.complete.all</field>
        <field name="model">mizan.progress.claim</field>
        <field name="inherit_id" ref="mizan_contracting.view_progress_claim_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_complete_all_selection" type="object"
                            string="Complete All" class="btn-primary"
                            display="always"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>
