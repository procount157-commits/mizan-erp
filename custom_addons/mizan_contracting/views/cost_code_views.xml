<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cost_code_list" model="ir.ui.view">
        <field name="name">mizan.cost.code.list</field>
        <field name="model">mizan.cost.code</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="account_id" optional="show"/>
                <field name="note" optional="hide"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cost_code_search" model="ir.ui.view">
        <field name="name">mizan.cost.code.search</field>
        <field name="model">mizan.cost.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cost_code" model="ir.actions.act_window">
        <field name="name">Cost Codes</field>
        <field name="res_model">mizan.cost.code</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up your cost codes</p>
            <p>
                A cost code is the part of a job a cost belongs to — earthworks,
                concrete, electrical. Budget and actual line up against these,
                which is what turns "we are over" into "we are over on concrete".
            </p>
        </field>
    </record>

    <!-- ===================== Budget breakdown on the contract ============ -->
    <record id="view_contract_form_costcodes" model="ir.ui.view">
        <field name="name">mizan.contract.form.costcodes</field>
        <field name="model">mizan.contract</field>
        <field name="inherit_id" ref="mizan_contracting.view_mizan_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cost Breakdown" name="cost_breakdown">
                    <div class="alert alert-warning" role="alert"
                         invisible="not budget_line_mismatch">
                        The cost codes below do not add up to the contract
                        budget. One of the two is out of date.
                    </div>
                    <field name="budget_line_ids"
                           context="{'default_contract_id': id}">
                        <list editable="bottom"
                              decoration-danger="is_over">
                            <field name="sequence" widget="handle"/>
                            <field name="cost_code_id"/>
                            <field name="category" optional="show"/>
                            <field name="budget_amount" sum="Budget"/>
                            <field name="actual_amount" sum="Actual"/>
                            <field name="committed_amount" sum="Committed"/>
                            <field name="total_exposure" sum="Actual + Committed"/>
                            <field name="variance" sum="Variance"/>
                            <field name="variance_percent" optional="show"/>
                            <field name="note" optional="hide"/>
                            <field name="is_over" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="budget_line_total"/>
                        <field name="committed_total"/>
                        <field name="exposure_total"/>
                        <field name="unbudgeted_cost"
                               invisible="not unbudgeted_cost"
                               decoration-danger="unbudgeted_cost != 0"/>
                        <field name="untagged_cost"
                               invisible="not untagged_cost"
                               decoration-warning="untagged_cost != 0"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='cost_to_complete']" position="after">
                <button name="action_estimate_from_commitments" type="object"
                        string="Estimate from commitments" class="btn-link"
                        invisible="not budget_line_ids"
                        help="Sets cost to complete from what is already ordered plus the unspent budget."/>
            </xpath>
        </field>
    </record>

    <!-- ===================== Cost code on documents ====================== -->
    <record id="view_move_form_costcode" model="ir.ui.view">
        <field name="name">account.move.form.costcode</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']"
                   position="after">
                <field name="mizan_cost_code_id" optional="show"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form_costcode" model="ir.ui.view">
        <field name="name">purchase.order.form.costcode</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='name']"
                   position="after">
                <field name="mizan_cost_code_id" optional="show"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_expense_form_costcode" model="ir.ui.view">
        <field name="name">hr.expense.form.costcode</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="mizan_cost_code_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
