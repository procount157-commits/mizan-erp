<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_retention" model="ir.ui.view">
        <field name="name">account.move.form.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_withhold_retention" type="object"
                        string="Withhold Retention" class="btn-secondary"
                        invisible="state != 'posted' or mizan_retention_move_id or move_type not in ('out_invoice', 'in_invoice')"
                        help="Move the retained percentage to the retention account and settle it against this document."/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_retention_entry" type="object"
                        class="oe_stat_button" icon="fa-hand-paper-o"
                        invisible="not mizan_retention_move_id">
                    <field name="mizan_retention_amount" widget="statinfo"
                           string="Retention"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="mizan_contract_id"
                       invisible="move_type not in ('out_invoice', 'in_invoice')"
                       options="{'no_create': True}"/>
                <field name="mizan_retention_percent"
                       invisible="move_type not in ('out_invoice', 'in_invoice')"
                       readonly="mizan_retention_move_id != False"/>
                <field name="mizan_retention_move_id" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
