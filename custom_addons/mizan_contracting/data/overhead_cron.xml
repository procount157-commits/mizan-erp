<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_overhead_allocation" model="ir.cron">
            <field name="name">Contracting: share last month's overhead across the jobs</field>
            <field name="model_id" ref="model_mizan_overhead_allocation"/>
            <field name="state">code</field>
            <field name="code">model._cron_allocate_last_month()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now().replace(day=1) + relativedelta(months=1)).strftime('%Y-%m-%d 02:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
