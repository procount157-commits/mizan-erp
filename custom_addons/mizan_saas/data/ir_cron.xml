<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_backup_all" model="ir.cron">
            <field name="name">Operations: back up every client</field>
            <field name="model_id" ref="model_mizan_tenant_backup"/>
            <field name="state">code</field>
            <field name="code">model.cron_backup_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=22, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_snapshot_metrics" model="ir.cron">
            <field name="name">Operations: record client usage</field>
            <field name="model_id" ref="model_mizan_tenant"/>
            <field name="state">code</field>
            <field name="code">model.cron_snapshot_metrics()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=23, minute=30, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
