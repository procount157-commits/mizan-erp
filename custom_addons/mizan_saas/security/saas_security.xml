<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_saas_operator" model="res.groups">
            <field name="name">Operations Console</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">Can see the client register and take backups.</field>
        </record>

        <record id="group_saas_manager" model="res.groups">
            <field name="name">Operations Console / Manager</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('group_saas_operator'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Can provision, suspend and close client deployments.</field>
        </record>
    </data>
</odoo>
