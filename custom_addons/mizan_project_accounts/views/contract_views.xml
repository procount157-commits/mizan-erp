<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_form_accounts" model="ir.ui.view">
        <field name="name">mizan.contract.form.project.accounts</field>
        <field name="model">mizan.contract</field>
        <field name="inherit_id" ref="mizan_contracting.view_mizan_contract_form"/>
        <field name="arch" type="xml">
            <button name="action_create_recognition" position="before">
                <button name="action_progress_window" type="object" string="Progress to date" icon="fa-percent"
                        class="btn-primary" invisible="state != 'running' or not has_project_accounts"/>
                <button name="action_invoice_instalment" type="object" string="Invoice an instalment" icon="fa-file-text-o"
                        invisible="state != 'running' or not has_project_accounts"
                        groups="account.group_account_invoice"/>
                <button name="action_create_project_accounts" type="object" string="Create project accounts"
                        icon="fa-book" invisible="has_project_accounts or state == 'cancel'"
                        groups="account.group_account_manager"/>
            </button>
            <button name="action_create_recognition" position="attributes">
                <attribute name="invisible">state != 'running' or billing_mode != 'progress' and has_project_accounts</attribute>
            </button>
            <field name="contract_value" position="before">
                <field name="billing_mode" widget="radio"/>
                <field name="has_project_accounts" invisible="1"/>
            </field>
            <notebook position="inside">
                <page string="Project accounts" name="project_accounts" invisible="not has_project_accounts">
                    <group>
                        <group string="Accounts">
                            <field name="receivable_account_id"/>
                            <field name="billing_account_id"/>
                            <field name="wip_account_id"/>
                            <field name="retention_account_id"/>
                            <field name="cost_account_id"/>
                            <field name="stock_location_id" groups="stock.group_stock_user"/>
                        </group>
                        <group string="From the ledger">
                            <field name="client_balance"/>
                            <field name="billed_net"/>
                            <field name="billing_balance"/>
                            <field name="wip_balance"/>
                            <field name="cost_recognised"/>
                            <field name="retention_balance"/>
                            <field name="margin_to_date"/>
                        </group>
                    </group>
                    <group string="Where the cost came from">
                        <group>
                            <field name="cost_bills"/>
                            <field name="cost_subcontract"/>
                            <field name="cost_petty"/>
                        </group>
                        <group>
                            <field name="cost_labour"/>
                            <field name="cost_stock"/>
                            <field name="cost_other"/>
                        </group>
                    </group>
                    <div class="d-flex gap-2 flex-wrap">
                        <button name="action_ledger_all" type="object" string="Project ledger" icon="fa-book" class="btn-secondary"/>
                        <button name="action_ledger_cost" type="object" string="Costs" icon="fa-money" class="btn-secondary"/>
                        <button name="action_ledger_billing" type="object" string="Billing" icon="fa-file-text-o" class="btn-secondary"/>
                        <button name="action_ledger_client" type="object" string="Client account" icon="fa-user" class="btn-secondary"/>
                        <button name="action_ledger_retention" type="object" string="Retention" icon="fa-lock" class="btn-secondary"/>
                    </div>
                </page>
            </notebook>
        </field>
    </record>

    <!-- The project cards: one per running contract, the figures that matter,
         each one a door into its lines. -->
    <record id="view_project_card_kanban" model="ir.ui.view">
        <field name="name">mizan.contract.project.kanban</field>
        <field name="model">mizan.contract</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile o_mizan_project_cards" create="0" default_order="code">
                <field name="state"/>
                <field name="currency_id"/>
                <field name="has_project_accounts"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="min-w-0">
                                <strong class="fs-5 text-truncate d-block"><field name="name"/></strong>
                                <div class="text-muted small"><field name="code"/> · <field name="partner_id"/></div>
                            </div>
                            <span class="badge rounded-pill text-bg-success"><field name="completion_percent" digits="[5,1]"/>%</span>
                        </div>
                        <div class="progress my-2" style="height:6px">
                            <div class="progress-bar bg-success" t-attf-style="width: {{ record.completion_percent.raw_value }}%"/>
                        </div>
                        <div class="row g-2 small" t-if="record.has_project_accounts.raw_value">
                            <div class="col-6">
                                <div class="text-muted">Billed</div>
                                <button name="action_ledger_billing" type="object" class="btn btn-link p-0 fw-bold"><field name="billed_net" widget="monetary"/></button>
                            </div>
                            <div class="col-6">
                                <div class="text-muted">Cost to date</div>
                                <button name="action_ledger_cost" type="object" class="btn btn-link p-0 fw-bold"><field name="cost_incurred" widget="monetary"/></button>
                            </div>
                            <div class="col-6">
                                <div class="text-muted">Client owes</div>
                                <button name="action_ledger_client" type="object" class="btn btn-link p-0 fw-bold"><field name="client_balance" widget="monetary"/></button>
                            </div>
                            <div class="col-6">
                                <div class="text-muted">Client holds</div>
                                <button name="action_ledger_retention" type="object" class="btn btn-link p-0 fw-bold"><field name="retention_balance" widget="monetary"/></button>
                            </div>
                            <div class="col-6">
                                <div class="text-muted">Contract value</div>
                                <div class="fw-bold"><field name="contract_value" widget="monetary"/></div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted">Revenue recognised</div>
                                <div class="fw-bold"><field name="revenue_recognised" widget="monetary"/></div>
                            </div>
                        </div>
                        <div class="small mt-2 pt-2 border-top" t-if="record.has_project_accounts.raw_value">
                            <div class="text-muted mb-1">Where the cost came from</div>
                            <div class="d-flex flex-wrap gap-1">
                                <span class="badge text-bg-light" t-if="record.cost_bills.raw_value">Supplier bills <field name="cost_bills" widget="monetary"/></span>
                                <span class="badge text-bg-light" t-if="record.cost_subcontract.raw_value">Subcontractors <field name="cost_subcontract" widget="monetary"/></span>
                                <span class="badge text-bg-light" t-if="record.cost_petty.raw_value">Petty cash <field name="cost_petty" widget="monetary"/></span>
                                <span class="badge text-bg-light" t-if="record.cost_labour.raw_value">Labour <field name="cost_labour" widget="monetary"/></span>
                                <span class="badge text-bg-light" t-if="record.cost_stock.raw_value">Stock <field name="cost_stock" widget="monetary"/></span>
                                <span class="badge text-bg-light" t-if="record.cost_other.raw_value">Entries <field name="cost_other" widget="monetary"/></span>
                            </div>
                        </div>
                        <div t-else="" class="alert alert-warning py-1 px-2 small mb-0" role="status">
                            No project accounts yet. Open the contract and press "Create project accounts".
                        </div>
                        <div class="mt-2 d-flex gap-2">
                            <button name="action_ledger_all" type="object" class="btn btn-secondary btn-sm flex-fill"><i class="fa fa-book me-1" title="Ledger"/>Ledger</button>
                            <button name="action_progress_window" type="object" class="btn btn-primary btn-sm flex-fill" t-if="record.has_project_accounts.raw_value"><i class="fa fa-percent me-1" title="Progress"/>Progress</button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_project_cards" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">mizan.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_project_card_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mizan_contracting.view_mizan_contract_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mizan_contracting.view_mizan_contract_form')})]"/>
        <field name="domain">[('state', 'in', ('running', 'done'))]</field>
        <field name="context">{'search_default_running': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No running project yet</p>
            <p>Start a contract and its accounts, cost centre, project and site location are created for it.</p>
        </field>
    </record>
</odoo>
