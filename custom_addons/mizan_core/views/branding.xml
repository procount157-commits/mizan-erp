<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The tab icon and the default title: Miqyas, not Odoo. -->
    <template id="layout_brand" inherit_id="web.layout" name="Miqyas tab icon">
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link rel="icon" type="image/svg+xml" href="/mizan_core/static/img/miqyas.svg"/>
        </xpath>
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'مقياس'"/>
        </xpath>
    </template>

    <!-- The sign-in card: the product's mark and name instead of Odoo's
         "Your logo" placeholder, and a footer that names who made it. -->
    <template id="login_layout_brand" inherit_id="web.login_layout" name="Miqyas sign-in">
        <xpath expr="//div[hasclass('card-body')]/div[1]" position="replace">
            <div class="text-center pb-3 border-bottom mb-4 o_miqyas_login">
                <img class="o_miqyas_mark" src="/mizan_core/static/img/miqyas.svg" alt="مقياس"/>
                <div class="o_miqyas_name">مقياس</div>
                <div class="o_miqyas_tag">محاسبة المقاولات</div>
            </div>
        </xpath>
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a href="https://getmihwar.com/miqyas/" target="_blank">مقياس · <span>محور</span></a>
        </xpath>
    </template>
</odoo>
