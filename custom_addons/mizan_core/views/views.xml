<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <!-- Platform administration: installing modules, creating companies and
             managing user accounts. These belong to whoever runs the service,
             not to the client renting it. A client who installs a module breaks
             their own database and the next upgrade for everyone; a client who
             adds companies changes what they are being billed for.

             Deliberately granted to nobody here. Provisioning gives it to the
             support login only, so a fresh client database has no account that
             can reach any of it. -->
        <record id="group_platform_admin" model="res.groups">
            <field name="name">Platform Administration</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Install modules, manage companies and user
                accounts. Held by the service operator, never by the client.</field>
        </record>
    </data>

    <!-- Navigation modelled on Zoho Books: grouped by business process
         (Sales, Purchases, Accountant, VAT) instead of by Odoo app, so a
         restaurant owner finds "record a payment" without knowing which
         Odoo module owns it. -->
    <menuitem id="menu_mizan_root" name="ProAccount" sequence="1"/>

    <!-- ===== Home ===== -->
    <!-- Home is the accounting dashboard, so it is restricted to people with
         accounting rights. Without this an engineer signs in and is met by an
         access error instead of a home screen. Everyone else lands on the
         first section they can use, which is Projects. -->
    <menuitem id="menu_mizan_home" name="Home" parent="menu_mizan_root" sequence="10"
              action="account.open_account_journal_dashboard_kanban"
              groups="account.group_account_readonly"/>

    <!-- ===== Projects ===== -->
    <menuitem id="menu_mizan_projects_top" name="Projects" parent="menu_mizan_root" sequence="20"
              action="project.open_view_project_all"/>

    <!-- ===== Banking ===== -->
    <menuitem id="menu_mizan_banking" name="Banking" parent="menu_mizan_root" sequence="30"
              groups="account.group_account_invoice"/>
    <menuitem id="menu_mizan_bank_accounts" name="Bank &amp; Cash Accounts" parent="menu_mizan_banking"
              action="account.action_account_journal_form" sequence="10"/>
    <menuitem id="menu_mizan_reconcile" name="Reconciliation" parent="menu_mizan_banking"
              action="account_reconcile_oca.action_bank_statement_line_reconcile" sequence="20"/>
    <menuitem id="menu_mizan_cheques_received" name="Cheques Received" parent="menu_mizan_banking"
              action="mizan_cheque.action_mizan_cheque_received" sequence="30"/>
    <menuitem id="menu_mizan_cheques_issued" name="Cheques Issued" parent="menu_mizan_banking"
              action="mizan_cheque.action_mizan_cheque_issued" sequence="40"/>

    <!-- ===== Sales ===== -->
    <menuitem id="menu_mizan_sales" name="Sales" parent="menu_mizan_root" sequence="40"
              groups="sales_team.group_sale_salesman,account.group_account_invoice"/>
    <menuitem id="menu_mizan_customers" name="Customers" parent="menu_mizan_sales"
              action="account.res_partner_action_customer" sequence="10"/>
    <menuitem id="menu_mizan_quotes" name="Quotes" parent="menu_mizan_sales"
              action="sale.action_quotations_with_onboarding" sequence="20"/>
    <menuitem id="menu_mizan_sale_orders" name="Sales Orders" parent="menu_mizan_sales"
              action="sale.action_orders" sequence="30"/>
    <menuitem id="menu_mizan_customer_invoices" name="Invoices" parent="menu_mizan_sales"
              action="account.action_move_out_invoice_type" sequence="40"/>
    <menuitem id="menu_mizan_payments_received" name="Receipt Vouchers" parent="menu_mizan_sales"
              action="account.action_account_payments" sequence="50"/>
    <menuitem id="menu_mizan_credit_notes" name="Credit Notes" parent="menu_mizan_sales"
              action="account.action_move_out_refund_type" sequence="60"/>

    <!-- Approving from a phone.
         Odoo 18 does not render the expense form's header buttons below about
         768px — Approve and Refuse are absent from the page entirely, not
         merely hidden — so a manager holding a phone cannot approve anything.
         Row buttons in a list do render at that width, so the approval lives
         here instead of on the form. -->
    <record id="view_mizan_petty_approve_list" model="ir.ui.view">
        <field name="name">hr.expense.sheet.approve.list</field>
        <field name="model">hr.expense.sheet</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'submit'">
                <field name="employee_id"/>
                <field name="name" string="Claim"/>
                <field name="accounting_date" optional="hide"/>
                <field name="total_amount" sum="Total" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="can_approve" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'submit'"
                       decoration-success="state in ('approve', 'post', 'done')"/>
                <button name="action_approve_expense_sheets" type="object"
                        string="Approve" icon="fa-check-circle"
                        class="text-success"
                        invisible="not can_approve or state != 'submit'"/>
                <button name="action_refuse_expense_sheets" type="object"
                        string="Refuse" icon="fa-times-circle"
                        class="text-danger"
                        invisible="not can_approve or state != 'submit'"/>
            </list>
        </field>
    </record>

    <!-- On a phone Odoo opens this action as a kanban, not a list, so the
         approval has to be on the card as well as the row. -->
    <record id="view_mizan_petty_approve_kanban" model="ir.ui.view">
        <field name="name">hr.expense.sheet.approve.kanban</field>
        <field name="model">hr.expense.sheet</field>
        <field name="arch" type="xml">
            <kanban create="0" class="o_kanban_mobile">
                <field name="can_approve"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="row mb-1">
                            <div class="col-8">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="col-4 text-end">
                                <strong><field name="total_amount" widget="monetary"/></strong>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-7 text-muted">
                                <i class="fa fa-user me-1" title="الموظف"/><field name="employee_id"/>
                            </div>
                            <div class="col-5 text-end">
                                <field name="state" widget="badge"
                                       decoration-warning="state == 'submit'"
                                       decoration-success="state in ('approve','post','done')"/>
                            </div>
                        </div>
                        <div class="row" t-if="record.can_approve.raw_value and record.state.raw_value == 'submit'">
                            <div class="col-6">
                                <button name="action_approve_expense_sheets" type="object"
                                        class="btn btn-success w-100">
                                    <i class="fa fa-check me-1" title="اعتماد"/>اعتماد
                                </button>
                            </div>
                            <div class="col-6">
                                <button name="action_refuse_expense_sheets" type="object"
                                        class="btn btn-outline-danger w-100">
                                    <i class="fa fa-times me-1" title="رفض"/>رفض
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_mizan_petty_to_approve" model="ir.actions.act_window">
        <field name="name">Claims to Approve</field>
        <field name="res_model">hr.expense.sheet</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list',   'view_id': ref('view_mizan_petty_approve_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_mizan_petty_approve_kanban')}),
            (0, 0, {'view_mode': 'form',   'view_id': False})]"/>
        <field name="domain">[('state', '=', 'submit')]</field>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is waiting for you</p>
            <p>Petty cash claims appear here once staff submit them.</p>
        </field>
    </record>

