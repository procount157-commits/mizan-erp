<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <!-- Platform administration: installing modules, creating companies and
             managing user accounts. These belong to whoever runs the service,
             not to the client renting it. A client who installs a module breaks
             their own database and the next upgrade for everyone; a client who
             adds companies changes what they are being billed for.

             Deliberately granted to nobody here. Provisioning gives it to the
             support login only, so a fresh client database has no account that
             can reach any of it. -->
        <record id="group_platform_admin" model="res.groups">
            <field name="name">Platform Administration</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Install modules, manage companies and user
                accounts. Held by the service operator, never by the client.</field>
        </record>
    </data>

    <record id="view_mizan_petty_approve_list" model="ir.ui.view">
        <field name="name">hr.expense.sheet.approve.list</field>
        <field name="model">hr.expense.sheet</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'submit'">
                <field name="employee_id"/>
                <field name="name" string="Claim"/>
                <field name="accounting_date" optional="hide"/>
                <field name="total_amount" sum="Total" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="can_approve" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'submit'"
                       decoration-success="state in ('approve', 'post', 'done')"/>
                <button name="action_approve_expense_sheets" type="object"
                        string="Approve" icon="fa-check-circle"
                        class="text-success"
                        invisible="not can_approve or state != 'submit'"/>
                <button name="action_refuse_expense_sheets" type="object"
                        string="Refuse" icon="fa-times-circle"
                        class="text-danger"
                        invisible="not can_approve or state != 'submit'"/>
            </list>
        </field>
    </record>

    <!-- On a phone Odoo opens this action as a kanban, not a list, so the
         approval has to be on the card as well as the row. -->
    <record id="view_mizan_petty_approve_kanban" model="ir.ui.view">
        <field name="name">hr.expense.sheet.approve.kanban</field>
        <field name="model">hr.expense.sheet</field>
        <field name="arch" type="xml">
            <kanban create="0" class="o_kanban_mobile">
                <field name="can_approve"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="row mb-1">
                            <div class="col-8">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="col-4 text-end">
                                <strong><field name="total_amount" widget="monetary"/></strong>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-7 text-muted">
                                <i class="fa fa-user me-1" title="الموظف"/><field name="employee_id"/>
                            </div>
                            <div class="col-5 text-end">
                                <field name="state" widget="badge"
                                       decoration-warning="state == 'submit'"
                                       decoration-success="state in ('approve','post','done')"/>
                            </div>
                        </div>
                        <div class="row" t-if="record.can_approve.raw_value and record.state.raw_value == 'submit'">
                            <div class="col-6">
                                <button name="action_approve_expense_sheets" type="object"
                                        class="btn btn-success w-100">
                                    <i class="fa fa-check me-1" title="اعتماد"/>اعتماد
                                </button>
                            </div>
                            <div class="col-6">
                                <button name="action_refuse_expense_sheets" type="object"
                                        class="btn btn-outline-danger w-100">
                                    <i class="fa fa-times me-1" title="رفض"/>رفض
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_mizan_petty_to_approve" model="ir.actions.act_window">
        <field name="name">Claims to Approve</field>
        <field name="res_model">hr.expense.sheet</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list',   'view_id': ref('view_mizan_petty_approve_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_mizan_petty_approve_kanban')}),
            (0, 0, {'view_mode': 'form',   'view_id': False})]"/>
        <field name="domain">[('state', '=', 'submit')]</field>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is waiting for you</p>
            <p>Petty cash claims appear here once staff submit them.</p>
        </field>
    </record>

    <record id="action_mizan_menu_control" model="ir.actions.act_window">
        <field name="name">Show / Hide Menus</field>
        <field name="res_model">ir.ui.menu</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Turn any application on or off</p>
            <p>Untick <b>Active</b> to hide a menu, tick it to bring it back.
               Change <b>Sequence</b> to reorder.</p>
        </field>
    </record>

    <!-- ========================================================= NAVIGATION

         Rebuilt to be Odoo's navigation, not a second one beside it.

         The first version grouped everything by business process, Zoho Books
         style, under a single "ProAccount" app. It read well on paper and
         failed with the person it mattered to: an accountant who knows Odoo
         opened the system, found fifteen apps of which one was a complete
         duplicate of the others, and concluded it was not Odoo at all. He was
         right. Invoices appeared in three places, payments in four, and the
         standard Accounting app sat there beside the copy.

         So there is one home for accounting — Odoo's own — and everything
         built here is grafted into the section an accountant already looks in.
         What stays separate is the one thing Odoo has no place for: the
         contracting work, which gets its own app the way an industry vertical
         does.
    -->

    <!-- ===== Contracting: the industry app ===================== -->
    <menuitem id="menu_mizan_root" name="Contracting" sequence="16"
              web_icon="mizan_core,static/img/proaccount-icon-192x192.png"
              groups="account.group_account_readonly,project.group_project_manager"/>

    <menuitem id="menu_mizan_contracting" name="Operations" parent="menu_mizan_root"
              sequence="10"/>
    <menuitem id="menu_mizan_progress_claims" name="Progress Claims" parent="menu_mizan_contracting"
              action="mizan_contracting.action_progress_claim" sequence="10"/>
    <menuitem id="menu_mizan_contracts" name="Contracts" parent="menu_mizan_contracting"
              action="mizan_contracting.action_mizan_contract" sequence="20"/>
    <menuitem id="menu_mizan_boq" name="Bill of Quantities" parent="menu_mizan_contracting"
              action="mizan_contracting.action_boq_line" sequence="30"/>
    <menuitem id="menu_mizan_subcontracts" name="Subcontracts" parent="menu_mizan_contracting"
              action="mizan_contracting.action_subcontract" sequence="40"/>
    <menuitem id="menu_mizan_bonds" name="Guarantees &amp; Bonds" parent="menu_mizan_contracting"
              action="mizan_contracting.action_bond_register" sequence="50"
              groups="account.group_account_invoice"/>
    <menuitem id="menu_mizan_owned_plant" name="Owned Plant" parent="menu_mizan_contracting"
              action="mizan_contracting.action_plant" sequence="60"/>

    <menuitem id="menu_mizan_job_costing" name="Job Costing" parent="menu_mizan_root"
              sequence="20" groups="account.group_account_readonly"/>
    <menuitem id="menu_mizan_wip" name="Work in Progress" parent="menu_mizan_job_costing"
              action="mizan_contracting.action_mizan_wip" sequence="10"/>
    <menuitem id="menu_mizan_revenue_recognition" name="Revenue Recognition" parent="menu_mizan_job_costing"
              action="mizan_contracting.action_mizan_recognition" sequence="20"/>
    <menuitem id="menu_mizan_cost_centers" name="Cost Centers" parent="menu_mizan_job_costing"
              action="analytic.action_account_analytic_account_form" sequence="30"
              groups="analytic.group_analytic_accounting"/>
    <menuitem id="menu_mizan_project_budgets" name="Budgets" parent="menu_mizan_job_costing"
              action="account_budget_oca.act_crossovered_budget_view" sequence="40"/>

    <menuitem id="menu_mizan_contracting_config" name="Configuration" parent="menu_mizan_root"
              sequence="90" groups="account.group_account_manager,project.group_project_manager"/>
    <menuitem id="menu_mizan_cost_codes" name="Cost Codes" parent="menu_mizan_contracting_config"
              action="mizan_contracting.action_cost_code" sequence="10"/>

    <!-- ===== Grafted into Odoo's Accounting app ================= -->
    <!-- Accounting > Accounting: where an Odoo accountant already goes for
         bank work, so that is where the bank work is. -->
    <menuitem id="menu_mizan_bank_statements" name="Bank Statements"
              parent="account.menu_finance_entries"
              action="action_mizan_bank_statements" sequence="26"
              groups="account.group_account_invoice"/>
    <menuitem id="menu_mizan_reconcile" name="Bank Reconciliation"
              parent="account.menu_finance_entries"
              action="action_mizan_bank_reconcile" sequence="27"
              groups="account.group_account_invoice"/>
    <menuitem id="menu_mizan_bank_transactions" name="Bank Transactions"
              parent="account.menu_finance_entries"
              action="action_mizan_statement_lines" sequence="28"
              groups="account.group_account_invoice"/>
    <menuitem id="menu_mizan_cheques_received" name="Cheques Received"
              parent="account.menu_finance_entries"
              action="mizan_cheque.action_mizan_cheque_received" sequence="31"
              groups="account.group_account_invoice"/>
    <menuitem id="menu_mizan_cheques_issued" name="Cheques Issued"
              parent="account.menu_finance_entries"
              action="mizan_cheque.action_mizan_cheque_issued" sequence="32"
              groups="account.group_account_invoice"/>

    <!-- Accounting > Reporting: Community ships no balance sheet or P&amp;L, so
         these are not extras — without them the app has no statements. -->
    <menuitem id="menu_mizan_trial_balance" name="Trial Balance"
              parent="account.menu_finance_reports"
              action="account_financial_report.action_trial_balance_wizard" sequence="5"
              groups="account.group_account_readonly"/>
    <menuitem id="menu_mizan_general_ledger" name="General Ledger"
              parent="account.menu_finance_reports"
              action="account_financial_report.action_general_ledger_wizard" sequence="6"
              groups="account.group_account_readonly"/>
    <menuitem id="menu_mizan_aged_partner" name="Aged Receivables"
              parent="account.menu_finance_reports"
              action="account_financial_report.action_aged_partner_balance_wizard" sequence="7"
              groups="account.group_account_readonly"/>
    <menuitem id="menu_mizan_open_items" name="Open Items"
              parent="account.menu_finance_reports"
              action="account_financial_report.action_open_items_wizard" sequence="8"
              groups="account.group_account_readonly"/>
    <menuitem id="menu_mizan_journal_ledger" name="Journal Ledger"
              parent="account.menu_finance_reports"
              action="account_financial_report.action_journal_ledger_wizard" sequence="9"
              groups="account.group_account_readonly"/>
    <menuitem id="menu_mizan_vat_report" name="VAT Return"
              parent="account.menu_finance_reports"
              action="account_financial_report.action_vat_report_wizard" sequence="10"
              groups="account.group_account_invoice"/>

    <!-- Accounting > Configuration -->
    <menuitem id="menu_mizan_statement_templates" name="Statement Templates"
              parent="account.menu_finance_configuration"
              action="mis_builder.mis_report_view_action" sequence="80"
              groups="account.group_account_manager"/>
    <menuitem id="menu_mizan_doc_stamp" name="Stamp &amp; Signature"
              parent="account.menu_finance_configuration"
              action="mizan_documents.action_mizan_company_documents" sequence="81"
              groups="account.group_account_manager"/>
    <menuitem id="menu_mizan_doc_bank" name="Company Bank Accounts"
              parent="account.menu_finance_configuration"
              action="mizan_documents.action_mizan_bank_accounts" sequence="82"
              groups="account.group_account_manager"/>

    <!-- ===== Grafted into Expenses and Payroll ================== -->
    <!-- The approval list a manager reaches from a phone. It lives in the
         Expenses app because that is where approvals belong, and it exists
         because Odoo 18 does not draw form header buttons on a narrow screen. -->
    <menuitem id="menu_mizan_petty_approve" name="To Approve"
              parent="hr_expense.menu_hr_expense_root"
              action="action_mizan_petty_to_approve" sequence="15"
              groups="hr_expense.group_hr_expense_team_approver,hr_expense.group_hr_expense_user,hr_expense.group_hr_expense_manager"/>
    <!-- Restricted, or it makes the whole Payroll app visible to a site
         engineer: a menu with no groups is visible to everyone, and a visible
         child is what makes its parent app appear. -->
    <menuitem id="menu_mizan_wps" name="WPS Salary Files"
              parent="payroll.payroll_menu_root"
              action="mizan_wps.action_mizan_wps" sequence="60"
              groups="account.group_account_manager,hr.group_hr_manager"/>

    <!-- ===== Tidying Odoo's own tree ============================ -->
    <!-- The OCA purchase-request module opens its own top-level app. A
         purchase request is a step before a purchase order, so it belongs
         inside Purchase — a stray sixteenth app is exactly the kind of thing
         that makes an Odoo user say the system is not Odoo. -->
    <menuitem id="purchase_request.parent_menu_purchase_request"
              parent="purchase.menu_purchase_root" sequence="4"/>

    <!-- ===== Platform: the operator's own, never the client's ==== -->
    <menuitem id="menu_mizan_platform" name="Platform" sequence="200"
              web_icon="mizan_core,static/img/platform-icon.png"
              groups="group_platform_admin"/>
    <menuitem id="menu_mizan_users" name="Users" parent="menu_mizan_platform"
              action="base.action_res_users" sequence="10"
              groups="group_platform_admin"/>
    <menuitem id="menu_mizan_companies" name="Companies" parent="menu_mizan_platform"
              action="base.action_res_company_form" sequence="20"
              groups="group_platform_admin"/>
    <menuitem id="menu_mizan_menu_editor" name="Show / Hide Menus" parent="menu_mizan_platform"
              action="action_mizan_menu_control" sequence="30"
              groups="group_platform_admin"/>
    <menuitem id="menu_mizan_modules" name="All Modules" parent="menu_mizan_platform"
              action="base.open_module_tree" sequence="40"
              groups="group_platform_admin"/>

</odoo>
