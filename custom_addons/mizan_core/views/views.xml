<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Construction Actions -->
    <record id="action_mizan_projects" model="ir.actions.act_window">
        <field name="name">Construction Projects</field>
        <field name="res_model">mizan.contract.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Gold Actions -->
    <record id="action_mizan_gold" model="ir.actions.act_window">
        <field name="name">Gold Fixing Contracts</field>
        <field name="res_model">mizan.gold.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Top Level Menu -->
    <menuitem id="menu_mizan_root" name="Mizan ERP Enterprise" sequence="1"/>
    
    <!-- Sub Menus -->
    <menuitem id="menu_mizan_projects_sub" name="Construction Projects" parent="menu_mizan_root" action="action_mizan_projects" sequence="10"/>
    <menuitem id="menu_mizan_gold_sub" name="Gold Price Fixing" parent="menu_mizan_root" action="action_mizan_gold" sequence="20"/>
</odoo>
