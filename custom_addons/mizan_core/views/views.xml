<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ========================= -->
    <!-- CONTACTS                  -->
    <!-- ========================= -->

    <record id="view_mizan_contact_list" model="ir.ui.view">
        <field name="name">mizan.contact.list</field>
        <field name="model">mizan.contact</field>
        <field name="arch" type="xml">
            <list string="Contacts">
                <field name="name"/>
                <field name="contact_type"/>
                <field name="tax_number"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mizan_contact_form" model="ir.ui.view">
        <field name="name">mizan.contact.form</field>
        <field name="model">mizan.contact</field>
        <field name="arch" type="xml">
            <form string="Contact">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="contact_type"/>
                            <field name="tax_number"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                    </group>

                    <group>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mizan_contacts" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">mizan.contact</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================= -->
    <!-- TAXES                     -->
    <!-- ========================= -->

    <record id="view_mizan_tax_list" model="ir.ui.view">
        <field name="name">mizan.tax.list</field>
        <field name="model">mizan.tax</field>
        <field name="arch" type="xml">
            <list string="Taxes">
                <field name="name"/>
                <field name="rate"/>
                <field name="tax_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mizan_tax_form" model="ir.ui.view">
        <field name="name">mizan.tax.form</field>
        <field name="model">mizan.tax</field>
        <field name="arch" type="xml">
            <form string="Tax">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="rate"/>
                        <field name="tax_type"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mizan_taxes" model="ir.actions.act_window">
        <field name="name">Taxes</field>
        <field name="res_model">mizan.tax</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================= -->
    <!-- INVOICES                  -->
    <!-- ========================= -->

    <record id="view_mizan_invoice_list" model="ir.ui.view">
        <field name="name">mizan.invoice.list</field>
        <field name="model">mizan.invoice</field>
        <field name="arch" type="xml">
            <list string="Invoices">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="contact_id"/>
                <field name="invoice_type"/>
                <field name="untaxed_amount"/>
                <field name="tax_amount"/>
                <field name="total_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mizan_invoice_form" model="ir.ui.view">
        <field name="name">mizan.invoice.form</field>
        <field name="model">mizan.invoice</field>
        <field name="arch" type="xml">

            <form string="Invoice">

                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="invoice_type"/>
                        </group>

                        <group>
                            <field name="contact_id"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Invoice Lines">

                            <field name="line_ids">

                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="tax_id"/>
                                    <field name="tax_rate"/>
                                    <field name="subtotal"/>
                                    <field name="tax_amount"/>
                                    <field name="total"/>
                                </list>

                            </field>

                        </page>

                        <page string="Notes">
                            <field name="notes"/>
                        </page>

                    </notebook>

                    <group class="oe_subtotal_footer oe_right">

                        <field name="untaxed_amount"/>
                        <field name="tax_amount"/>

                        <div class="oe_subtotal_footer_separator oe_inline">
                            <label for="total_amount"/>
                            <field name="total_amount"
                                   class="oe_subtotal_footer_separator"/>
                        </div>

                    </group>

                </sheet>

            </form>

        </field>
    </record>

    <record id="action_mizan_invoices" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">mizan.invoice</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================= -->
    <!-- MENUS                     -->
    <!-- ========================= -->

    <menuitem
        id="menu_mizan_root"
        name="Mizan"
        sequence="10"
    />

    <menuitem
        id="menu_mizan_accounting"
        name="Accounting"
        parent="menu_mizan_root"
        sequence="10"
    />

    <menuitem
        id="menu_mizan_invoices"
        name="Invoices"
        parent="menu_mizan_accounting"
        action="action_mizan_invoices"
        sequence="10"
    />

    <menuitem
        id="menu_mizan_contacts"
        name="Contacts"
        parent="menu_mizan_root"
        action="action_mizan_contacts"
        sequence="20"
    />

    <menuitem
        id="menu_mizan_tax"
        name="Taxes"
        parent="menu_mizan_root"
        action="action_mizan_taxes"
        sequence="30"
    />

</odoo>
