<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    A UAE tax invoice, not a banner.

    What was here before was eleven lines: a coloured strip across the top of
    Odoo's standard invoice carrying a brand name. It looked like a letterhead
    and it left out most of what Federal Decree-Law 8 on VAT requires a tax
    invoice to state — above all both parties' TRNs, without which the buyer
    cannot reclaim the input tax and the document is not a tax invoice at all.

    This replaces it with the document the FTA describes: the words "Tax
    Invoice" shown plainly, both TRNs, the supply date where it differs from
    the issue date, tax shown per line and in total, and everything in AED.
    Bilingual throughout, because the client's accountant reads Arabic and the
    consultant's quantity surveyor often does not.

    The contracting block only draws when the invoice came from a progress
    claim: contract, claim number, retention withheld and advance recovered.
    A client receiving a claim needs to see why the net differs from the gross,
    and putting it in the covering email instead is how disputes start.
-->

<template id="report_mizan_invoice_document" inherit_id="account.report_invoice_document">

    <!-- Odoo's own header block is replaced wholesale: it prints "Invoice"
         and an address, which is not a UAE tax invoice. -->
    <xpath expr="//div[hasclass('page')]" position="before">
        <div class="row mb-3" style="border-bottom:3px solid #1A3C6E;padding-bottom:8px;">
            <div class="col-7">
                <h3 style="margin:0;color:#1A3C6E;font-weight:bold;">
                    <span t-if="o.move_type == 'out_invoice'">فاتورة ضريبية</span>
                    <span t-if="o.move_type == 'out_refund'">إشعار دائن ضريبي</span>
                    <span t-if="o.move_type == 'in_invoice'">فاتورة مورّد</span>
                    <span t-if="o.move_type == 'in_refund'">إشعار مدين</span>
                </h3>
                <div style="color:#1A3C6E;letter-spacing:1px;font-size:13px;">
                    <span t-if="o.move_type == 'out_invoice'">TAX INVOICE</span>
                    <span t-if="o.move_type == 'out_refund'">TAX CREDIT NOTE</span>
                    <span t-if="o.move_type == 'in_invoice'">VENDOR BILL</span>
                    <span t-if="o.move_type == 'in_refund'">DEBIT NOTE</span>
                </div>
            </div>
            <div class="col-5 text-end">
                <div style="font-size:12px;">
                    <strong>رقم الفاتورة / Invoice No.</strong>
                    <span t-field="o.name"/>
                </div>
                <div style="font-size:12px;">
                    <strong>التاريخ / Date</strong>
                    <span t-field="o.invoice_date"/>
                </div>
                <div style="font-size:12px;"
                     t-if="o.delivery_date and o.delivery_date != o.invoice_date">
                    <strong>تاريخ التوريد / Supply Date</strong>
                    <span t-field="o.delivery_date"/>
                </div>
                <div style="font-size:12px;" t-if="o.invoice_date_due">
                    <strong>الاستحقاق / Due</strong>
                    <span t-field="o.invoice_date_due"/>
                </div>
            </div>
        </div>

        <!-- Both TRNs. The single most common reason a UAE tax invoice is
             rejected is that one of them is absent. -->
        <div class="row mb-3">
            <div class="col-6" style="font-size:12px;">
                <div style="background:#f4f6f8;padding:6px;font-weight:bold;">
                    المورّد / Supplier
                </div>
                <div style="padding:6px;">
                    <strong t-field="o.company_id.name"/><br/>
                    <span t-field="o.company_id.partner_id"
                          t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/>
                    <div t-if="o.company_id.vat">
                        <strong>الرقم الضريبي / TRN:</strong>
                        <span t-field="o.company_id.vat"/>
                    </div>
                    <div t-if="not o.company_id.vat" style="color:#b00;">
                        الرقم الضريبي غير مُسجَّل — TRN NOT SET
                    </div>
                </div>
            </div>
            <div class="col-6" style="font-size:12px;">
                <div style="background:#f4f6f8;padding:6px;font-weight:bold;">
                    العميل / Customer
                </div>
                <div style="padding:6px;">
                    <strong t-field="o.partner_id.name"/><br/>
                    <span t-field="o.partner_id"
                          t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/>
                    <div t-if="o.partner_id.vat">
                        <strong>الرقم الضريبي / TRN:</strong>
                        <span t-field="o.partner_id.vat"/>
                    </div>
                </div>
            </div>
        </div>

        <!-- Why the net differs from the gross, on the document itself. -->
        <div class="row mb-2" t-if="o.mizan_contract_id"
             style="font-size:12px;border:1px solid #dee2e6;padding:6px;">
            <div class="col-4">
                <strong>العقد / Contract:</strong>
                <span t-field="o.mizan_contract_id.code"/>
            </div>
            <div class="col-4" t-if="o.mizan_retention_amount">
                <strong>المحتجز / Retention:</strong>
                <span t-field="o.mizan_retention_amount"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </div>
            <div class="col-4" t-if="o.mizan_advance_recovered">
                <strong>استرداد الدفعة / Advance:</strong>
                <span t-field="o.mizan_advance_recovered"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </div>
        </div>
    </xpath>

    <!-- Tax rate per line: the law asks for the rate applied to each item,
         and a contractor's invoice mixes standard, zero-rated and exempt. -->
    <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_taxes']"
           position="attributes">
        <attribute name="class">text-start</attribute>
    </xpath>

    <xpath expr="//div[hasclass('clearfix')][last()]" position="after">
        <div class="row mt-3" t-if="o.move_type in ('out_invoice', 'out_refund')">
            <div class="col-7" style="font-size:11px;">
                <div t-if="o.company_id.mizan_show_bank_on_quote and o.partner_bank_id"
                     style="border:1px solid #dee2e6;padding:6px;">
                    <strong>تفاصيل التحويل / Bank Details</strong><br/>
                    <span t-field="o.partner_bank_id.bank_id.name"/><br/>
                    <strong>IBAN:</strong> <span t-field="o.partner_bank_id.acc_number"/>
                </div>
                <div class="mt-2" style="color:#666;">
                    هذه فاتورة ضريبية صادرة وفق المرسوم بقانون اتحادي رقم (٨) لسنة ٢٠١٧
                    بشأن ضريبة القيمة المضافة.<br/>
                    This is a tax invoice issued under UAE Federal Decree-Law No. 8 of 2017.
                </div>
            </div>
            <div class="col-5 text-center" style="font-size:11px;">
                <div t-if="o.company_id.mizan_stamp or o.company_id.mizan_signature">
                    <img t-if="o.company_id.mizan_signature"
                         t-att-src="image_data_uri(o.company_id.mizan_signature)"
                         style="max-height:55px;"/>
                    <img t-if="o.company_id.mizan_stamp"
                         t-att-src="image_data_uri(o.company_id.mizan_stamp)"
                         style="max-height:85px;"/>
                    <div t-if="o.company_id.mizan_signatory_name"
                         style="border-top:1px solid #333;margin-top:4px;padding-top:2px;">
                        <span t-field="o.company_id.mizan_signatory_name"/><br/>
                        <span t-field="o.company_id.mizan_signatory_title"/>
                    </div>
                </div>
            </div>
        </div>
    </xpath>

</template>

</odoo>
