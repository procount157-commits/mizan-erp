<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The watermark block, called by each document template.
         An earlier version hooked into web.external_layout so it would cover
         every report at once. That also put it in the Document Design preview,
         which renders the same layout with a base.document.layout wizard in
         place of the company — and the screen died before it could draw. Each
         document calling the block explicitly costs three lines and keeps the
         preview working. -->
    <template id="mizan_watermark_block">
        <t t-if="company.mizan_watermark">
            <div class="mizan-watermark">
                <img t-att-src="image_data_uri(company.mizan_watermark)" alt=""/>
            </div>
        </t>
    </template>

    <template id="mizan_watermark_style">
        <style>
            /* position: fixed is what repeats the mark on every page under
               wkhtmltopdf; anything else prints it once. */
            .mizan-watermark {
                position: fixed;
                top: 40%;
                left: 50%;
                transform: translate(-50%, -50%) rotate(-30deg);
                z-index: 0;
                pointer-events: none;
            }
            .mizan-watermark img {
                max-width: 380px;
                max-height: 380px;
                opacity: 0.08;
            }
            /* Keep the figures above the mark, or the PDF is unreadable. */
            .page, .article, table {
                position: relative;
                z-index: 1;
            }
        </style>
    </template>

</odoo>
