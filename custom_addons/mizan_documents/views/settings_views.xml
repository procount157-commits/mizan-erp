<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_mizan_documents" model="ir.ui.view">
        <field name="name">res.company.form.mizan.documents</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Stamp &amp; Signature" name="mizan_documents">
                    <div class="text-muted mb-3">
                        Printed on quotations, invoices and vouchers. A transparent
                        PNG keeps the stamp readable over the document text.
                    </div>
                    <group>
                        <group string="Stamp">
                            <field name="mizan_stamp" widget="image"
                                   options="{'size': [180, 180]}" nolabel="1"/>
                        </group>
                        <group string="Watermark">
                            <field name="mizan_watermark" widget="image"
                                   options="{'size': [180, 180]}" nolabel="1"/>
                        </group>
                        <group string="Signature">
                            <field name="mizan_signature" widget="image"
                                   options="{'size': [220, 110]}" nolabel="1"/>
                            <field name="mizan_signatory_name"/>
                            <field name="mizan_signatory_title"/>
                        </group>
                    </group>
                    <group string="Bank Details">
                        <field name="mizan_show_bank_on_quote"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_mizan_company_documents" model="ir.actions.act_window">
        <field name="name">Stamp &amp; Signature</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">form</field>
        <field name="res_id" eval="False"/>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>

    <record id="action_mizan_bank_accounts" model="ir.actions.act_window">
        <field name="name">Company Bank Accounts</field>
        <field name="res_model">res.partner.bank</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_id', '=', allowed_company_ids[0])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the account clients pay into</p>
            <p>The IBAN entered here prints on quotations and invoices, so clients
               do not have to ask for it before transferring.</p>
        </field>
    </record>

</odoo>
