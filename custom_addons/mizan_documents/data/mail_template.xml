<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_payment_receipt" model="mail.template">
            <field name="name">Payment: Voucher</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="subject">{{ object.company_id.name }} — سند {{ 'قبض' if object.payment_type == 'inbound' else 'صرف' }} {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="report_template_ids" eval="[(4, ref('account.action_report_payment_receipt'))]"/>
            <field name="auto_delete" eval="False"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="body_html" type="html">
                <div style="margin:0px;padding:0px;font-size:14px;">
                    <p style="margin:0 0 16px 0;">
                        السادة <t t-out="object.partner_id.name or ''">العميل</t> المحترمون،
                    </p>
                    <p style="margin:0 0 16px 0;">
                        نرفق لكم
                        <t t-if="object.payment_type == 'inbound'">سند القبض</t>
                        <t t-else="">سند الصرف</t>
                        رقم <strong t-out="object.name or ''">SND/0001</strong>
                        بمبلغ
                        <strong t-out="format_amount(object.amount, object.currency_id) or ''">0.00</strong>
                        بتاريخ <t t-out="format_date(object.date) or ''">التاريخ</t>.
                    </p>
                    <p style="margin:0 0 16px 0;">
                        شاكرين لكم حسن تعاملكم.
                    </p>
                    <p style="margin:0;">
                        <t t-out="object.company_id.name or ''">الشركة</t><br/>
                        <t t-if="object.company_id.phone">هاتف: <t t-out="object.company_id.phone"/><br/></t>
                        <t t-if="object.company_id.email"><t t-out="object.company_id.email"/></t>
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>
