<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_advance_form" model="ir.ui.view">
        <field name="name">mizan.employee.advance.form</field>
        <field name="model">mizan.employee.advance</field>
        <field name="arch" type="xml">
            <form string="Employee Advance">
                <header>
                    <button name="action_mizan_next" type="object"
                            string="Next action" class="btn-primary"
                            invisible="not mizan_next_label or state in ('settled', 'cancel')"/>
                    <button name="action_submit" type="object" string="Submit"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state != 'submitted'"
                            groups="account.group_account_manager,hr.group_hr_manager"/>
                    <button name="action_pay" type="object" string="Pay"
                            invisible="state != 'approved'"
                            groups="account.group_account_manager"/>
                    <button name="action_settle" type="object"
                            string="Settle against the claims"
                            invisible="state != 'paid'"
                            groups="account.group_account_manager"/>
                    <button name="action_return_balance" type="object"
                            string="Record the balance returned"
                            invisible="state != 'paid'"
                            groups="account.group_account_manager"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state not in ('submitted', 'approved')"/>
                    <button name="action_draft" type="object"
                            string="Back to draft"
                            invisible="state not in ('submitted', 'approved', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,paid,settled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not move_pay_id">
                            <span class="o_stat_text">Entries</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="status"
                         invisible="not mizan_next_hint or state in ('settled', 'cancel')">
                        <field name="mizan_next_hint" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not override_by_id">
                        <field name="override_reason" readonly="1" nolabel="1"/>
                        — <field name="override_by_id" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"
                                   readonly="state != 'draft'"/>
                            <field name="department_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="purpose" readonly="state not in ('draft', 'submitted')"/>
                        </group>
                        <group>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="journal_id"
                                   readonly="state in ('paid', 'settled')"/>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="analytic_account_id"
                                   readonly="state != 'draft'"/>
                            <field name="approved_by_id" readonly="1"
                                   invisible="not approved_by_id"/>
                        </group>
                    </group>
                    <group string="What is left" invisible="state in ('draft', 'submitted', 'approved')">
                        <group>
                            <field name="amount_spent" readonly="1"/>
                            <field name="amount_returned" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount_outstanding" readonly="1"/>
                            <field name="settlement_percent" readonly="1"
                                   digits="[16,1]"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Claims against it">
                            <field name="expense_sheet_ids" readonly="1">
                                <list create="false">
                                    <field name="name"/>
                                    <field name="accounting_date"/>
                                    <field name="total_amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note">
                            <field name="note"/>
                        </page>
                    </notebook>
                    <field name="mizan_next_label" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_advance_list" model="ir.ui.view">
        <field name="name">mizan.employee.advance.list</field>
        <field name="model">mizan.employee.advance</field>
        <field name="arch" type="xml">
            <list string="Employee Advances"
                  decoration-danger="state == 'paid' and amount_outstanding > 0"
                  decoration-muted="state in ('settled', 'cancel')">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="purpose"/>
                <field name="amount" sum="Advanced"/>
                <field name="amount_spent" sum="Spent"/>
                <field name="amount_returned" optional="hide" sum="Returned"/>
                <field name="amount_outstanding" sum="Outstanding"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'settled'"
                       decoration-warning="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_advance_search" model="ir.ui.view">
        <field name="name">mizan.employee.advance.search</field>
        <field name="model">mizan.employee.advance</field>
        <field name="arch" type="xml">
            <search string="Employee Advances">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="purpose"/>
                <filter name="outstanding" string="Still outstanding"
                        domain="[('amount_outstanding', '>', 0), ('state', '=', 'paid')]"/>
                <filter name="to_approve" string="Waiting for approval"
                        domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <filter name="overridden" string="Limit was overridden"
                        domain="[('override_by_id', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_dept" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_employee_advance" model="ir.actions.act_window">
        <field name="name">Employee Advances</field>
        <field name="res_model">mizan.employee.advance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_outstanding': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No advance is outstanding.</p>
            <p>An advance stays here until it is spent against claims or the balance comes back.</p>
        </field>
    </record>

</odoo>
