<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_approval" model="ir.ui.view">
        <field name="name">account.move.form.mizan.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mizan_approve_bill" type="object" string="Approve" class="btn-primary"
                        invisible="mizan_approval_state != 'to_approve'"/>
                <button name="action_mizan_refuse_bill" type="object" string="Refuse"
                        invisible="mizan_approval_state != 'to_approve'"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="status" invisible="mizan_approval_state != 'to_approve'">
                    This bill waits for the manager's approval before it can be paid.
                </div>
                <div class="alert alert-danger mb-0" role="status" invisible="mizan_approval_state != 'refused'">
                    The manager refused this bill.
                </div>
                <field name="mizan_approval_state" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_payment_request_list" model="ir.ui.view">
        <field name="name">mizan.payment.request.list</field>
        <field name="model">mizan.payment.request</field>
        <field name="arch" type="xml">
            <list string="Subcontractor payments for approval" create="0">
                <header>
                    <button name="action_approve" type="object" string="Approve and pay" class="btn-primary"/>
                    <button name="action_refuse" type="object" string="Refuse"/>
                </header>
                <field name="create_date" string="Requested"/>
                <field name="subcontract_id"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="amount" sum="Total"/>
                <field name="retention_amount"/>
                <field name="requested_by_id"/>
                <field name="state" widget="badge" decoration-warning="state == 'to_approve'" decoration-success="state == 'paid'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_payment_request" model="ir.actions.act_window">
        <field name="name">Subcontractor payments for approval</field>
        <field name="res_model">mizan.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>
    <menuitem id="menu_payment_request" name="Payments for Approval" parent="mizan_project_accounts.menu_sc_money"
              action="action_payment_request" sequence="5"/>

    <record id="view_settings_approvals" model="ir.ui.view">
        <field name="name">res.config.settings.mizan.approvals</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Approvals" name="mizan_mobile_api" groups="account.group_account_manager">
                    <block title="What waits for the manager">
                        <setting help="A posted supplier bill at or above this amount cannot be paid until a manager approves it. 0 turns it off.">
                            <label for="mizan_bill_approval_amount"/>
                            <field name="mizan_bill_approval_amount"/>
                        </setting>
                        <setting help="Payments to subcontractors are posted only when a manager approves them, from the phone or here.">
                            <field name="mizan_sc_payment_approval"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
